# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Generated by this project — reproducible from run_all.sh, don't commit
artifacts/
data/*.tsv
reports/*.json
reports/*.log

# Keep the folders themselves visible in git even though their contents are ignored
!artifacts/.gitkeep
!data/.gitkeep
!reports/.gitkeep
